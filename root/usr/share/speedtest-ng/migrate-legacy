RESULT_JSON="/etc/speedtest-ng_results.json"
LEGACY_RESULT="/etc/speedtest_result"
MIGRATED_MARK="/etc/speedtest-ng_migrated"

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g; s/\r//g; s/$/\\n/' | tr -d '\n' | sed 's/\\n$//'
}

trim() {
	local value="$1"
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	printf '%s' "$value"
}

lower() {
	printf '%s' "$1" | tr 'A-Z' 'a-z'
}

number_or_null() {
	local value
	value="$(printf '%s' "$1" | grep -oE '[-]?[0-9]+([.][0-9]+)?' | head -n 1)"
	[ -n "$value" ] && printf '%s' "$value" || printf 'null'
}

json_string_or_null() {
	[ -n "$1" ] && printf '"%s"' "$(json_escape "$1")" || printf 'null'
}

uuid() {
	if [ -r /proc/sys/kernel/random/uuid ]; then
		cat /proc/sys/kernel/random/uuid
	else
		printf '%s-%s' "$(date +%s)" "$$"
	fi
}

timezone_offset() {
	local offset
	offset="$(date '+%z')"
	if [ -n "$offset" ]; then
		printf '%s:%s' "${offset%??}" "${offset#???}"
	else
		printf '+00:00'
	fi
}

month_number() {
	case "$(lower "$1")" in
		jan|january) printf '01' ;;
		feb|february) printf '02' ;;
		mar|march) printf '03' ;;
		apr|april) printf '04' ;;
		may) printf '05' ;;
		jun|june) printf '06' ;;
		jul|july) printf '07' ;;
		aug|august) printf '08' ;;
		sep|sept|september) printf '09' ;;
		oct|october) printf '10' ;;
		nov|november) printf '11' ;;
		dec|december) printf '12' ;;
		*) printf '' ;;
	esac
}

int_value() {
	local value
	value="$(printf '%s' "$1" | sed 's/^0*//')"
	[ -n "$value" ] && printf '%s' "$value" || printf '0'
}

legacy_timestamp() {
	local date_text="$1"
	local time_text="$2"
	local date_part month day month_num day_num clock period hour minute hour_num minute_num year offset

	date_part="$(printf '%s' "$date_text" | sed 's/^[^,]*,[[:space:]]*//')"
	set -- $date_part
	month="$1"
	day="$2"
	day="${day%,}"

	month_num="$(month_number "$month")"
	day_num="$(int_value "$day")"

	set -- $time_text
	clock="$1"
	period="$(lower "$2")"
	hour="${clock%:*}"
	minute="${clock#*:}"
	hour_num="$(int_value "$hour")"
	minute_num="$(int_value "$minute")"

	[ -n "$month_num" ] || return 1
	[ "$day_num" -ge 1 ] 2>/dev/null && [ "$day_num" -le 31 ] 2>/dev/null || return 1
	[ "$hour_num" -ge 1 ] 2>/dev/null && [ "$hour_num" -le 12 ] 2>/dev/null || return 1
	[ "$minute_num" -ge 0 ] 2>/dev/null && [ "$minute_num" -le 59 ] 2>/dev/null || return 1

	case "$period" in
		pm) [ "$hour_num" -lt 12 ] && hour_num=$((hour_num + 12)) ;;
		am) [ "$hour_num" -eq 12 ] && hour_num=0 ;;
		*) return 1 ;;
	esac

	year="$(date '+%Y')"
	offset="$(timezone_offset)"
	printf '%04d-%s-%02dT%02d:%02d:00%s' "$year" "$month_num" "$day_num" "$hour_num" "$minute_num" "$offset"
}

ensure_json_file() {
	[ -e "$RESULT_JSON" ] || printf '[]\n' > "$RESULT_JSON"
}

trigger_from_method() {
	case "$(lower "$1")" in
		luci) printf 'manual' ;;
		schedule) printf 'scheduled' ;;
		*) printf '' ;;
	esac
}

test_from_legacy() {
	local value
	value="$(trim "$(lower "$1")")"

	case "$value" in
		all) printf 'all' ;;
		latency) printf 'latency' ;;
		download|download\ speed) printf 'download' ;;
		upload|upload\ speed) printf 'upload' ;;
		*) printf 'all' ;;
	esac
}

legacy_record() {
	local date_text="$1"
	local time_text="$2"
	local method="$3"
	local test="$4"
	local ping="$5"
	local jitter="$6"
	local latency="$7"
	local download="$8"
	local upload="$9"
	local trigger test_name timestamp_value

	trigger="$(trigger_from_method "$method")"
	test_name="$(test_from_legacy "$test")"
	timestamp_value="$(legacy_timestamp "$date_text" "$time_text" 2>/dev/null || true)"

	if [ -n "$timestamp_value" ]; then
		cat <<EOF
{
  "id":"$(json_escape "$(uuid)")",
  "timestamp":"$(json_escape "$timestamp_value")",
  "trigger":$(json_string_or_null "$trigger"),
  "test":$(json_string_or_null "$test_name"),
  "server":null,
  "client":null,
  "ping_ms":$(number_or_null "$ping"),
  "jitter_ms":$(number_or_null "$jitter"),
  "latency_ms":$(number_or_null "$latency"),
  "download_mbit":$(number_or_null "$download"),
  "upload_mbit":$(number_or_null "$upload"),
  "note":""
}
EOF
	else
		cat <<EOF
{
  "id":"$(json_escape "$(uuid)")",
  "timestamp":null,
  "legacy_date":$(json_string_or_null "$date_text"),
  "legacy_time":$(json_string_or_null "$time_text"),
  "trigger":$(json_string_or_null "$trigger"),
  "test":$(json_string_or_null "$test_name"),
  "server":null,
  "client":null,
  "ping_ms":$(number_or_null "$ping"),
  "jitter_ms":$(number_or_null "$jitter"),
  "latency_ms":$(number_or_null "$latency"),
  "download_mbit":$(number_or_null "$download"),
  "upload_mbit":$(number_or_null "$upload"),
  "note":""
}
EOF
	fi
}

# Prepare the entire legacy history before modifying the current results.
prepare_legacy() {
	local line date_text time_text method test ping jitter latency download upload record comma=''
	printf '[\n'
	tail -n +2 "$LEGACY_RESULT" | while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$(printf '%s' "$line" | tr -d '[:space:]|')" ] || continue
		IFS='|' read -r _ date_text time_text method test ping jitter latency download upload _ <<EOF
$line
EOF
		record="$(legacy_record \
			"$(trim "$date_text")" \
			"$(trim "$time_text")" \
			"$(trim "$method")" \
			"$(trim "$test")" \
			"$(trim "$ping")" \
			"$(trim "$jitter")" \
			"$(trim "$latency")" \
			"$(trim "$download")" \
			"$(trim "$upload")")" || exit 1
		printf '%s%s\n' "$comma" "$record" || exit 1
		comma=','
	done || return 1
	printf ']\n'
}

migrate() {
	local pending="$MIGRATED_MARK.pending" tmp="$RESULT_JSON.tmp.$$"
	[ -f "$LEGACY_RESULT" ] || return 0
	[ -f "$MIGRATED_MARK" ] && return 0

	# Keep the prepared IDs until completion. If history was committed but the
	# marker could not be written, a retry reuses those IDs and skips duplicates.
	if [ ! -f "$pending" ]; then
		(umask 077; prepare_legacy > "$tmp") || { rm -f "$tmp"; return 1; }
		mv "$tmp" "$pending" || { rm -f "$tmp"; return 1; }
	fi
	ensure_json_file || return 1
	SPD_FILE="$RESULT_JSON" SPD_TMP="$tmp" SPD_BATCH="$pending" SPD_MARK="$MIGRATED_MARK" ucode -e '
		let fs = require("fs");
		let records = json(fs.readfile(getenv("SPD_FILE")));
		let incoming = json(fs.readfile(getenv("SPD_BATCH")));
		if (type(records) != "array" || type(incoming) != "array")
			die("History must be a JSON array.\n");
		let seen = {};
		for (let record in records) {
			if (type(record) != "object" || type(record.id) != "string")
				die("Invalid history record.\n");
			seen[record.id] = true;
		}
		let added = 0;
		for (let record in incoming) {
			if (type(record) != "object" || type(record.id) != "string" || !length(record.id))
				die("Invalid migrated record.\n");
			if (exists(seen, record.id)) continue;
			seen[record.id] = true;
			push(records, record);
			added++;
		}
		let tmp = getenv("SPD_TMP");
		let marker = tmp + ".mark";
		if (added) {
			let content = sprintf("%.2J\n", records);
			if (fs.writefile(tmp, content) != length(content))
				die("Unable to prepare migrated history.\n");
		}
		if (fs.writefile(marker, "done\n") != 5)
			die("Unable to prepare migration marker.\n");
		if (added && !fs.rename(tmp, getenv("SPD_FILE")))
			die("Unable to save migrated history.\n");
		if (!fs.rename(marker, getenv("SPD_MARK")))
			die("Unable to save migration marker.\n");
		fs.unlink(getenv("SPD_BATCH"));
	' || { rm -f "$tmp" "$tmp.mark"; return 1; }
}

# Called by helper while it holds the results lock. This mode does not touch
# the original application's data or its migration marker.
clean_seq() {
	local tmp="${RESULT_JSON}.tmp.$$"
	[ -e "$RESULT_JSON" ] || return 0
	SPD_FILE="$RESULT_JSON" SPD_TMP="$tmp" ucode -e '
		let fs = require("fs");
		let records = json(fs.readfile(getenv("SPD_FILE")));
		if (type(records) != "array") die("History must be a JSON array.\n");
		let changed = false;
		for (let record in records) {
			if (type(record) != "object") die("Invalid history record.\n");
			if (exists(record, "seq")) {
				delete record.seq;
				changed = true;
			}
		}
		if (!changed) exit(0);
		let content = sprintf("%.2J\n", records);
		if (fs.writefile(getenv("SPD_TMP"), content) != length(content) ||
		    !fs.rename(getenv("SPD_TMP"), getenv("SPD_FILE")))
			die("Unable to remove legacy test numbers.\n");
	' || { rm -f "$tmp"; return 1; }
}

case "${1:-legacy}" in
	legacy) migrate ;;
	clean-seq) clean_seq ;;
	*) echo "Syntax: $0 [legacy|clean-seq]" >&2; exit 1 ;;
esac
